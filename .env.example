# ──────────────────────────────────────────────────────────────
# Finanzas Pro-BI — Variables de entorno
# ──────────────────────────────────────────────────────────────
# 1. Copia este archivo como .env.local  (git lo ignora)
# 2. Completa los valores desde tu proyecto Supabase:
#    https://supabase.com/dashboard → Settings → API
# ──────────────────────────────────────────────────────────────

# URL del proyecto Supabase (Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anon (safe to expose in frontend, protected by RLS)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ──────────────────────────────────────────────────────────────
# IMPORTANTE: NO uses la service_role key en el frontend.
# Si no configuras estas variables, la app funciona en modo
# DEMO usando localStorage (sin cuenta, sin persistencia real).
# ──────────────────────────────────────────────────────────────
